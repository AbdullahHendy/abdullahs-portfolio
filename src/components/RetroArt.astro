---
import { AsciiArt } from "./ui/ascii-art";

const cpuImg = "/cpu-art.png";
const dramImg = "/dram-art.png";
const acceleratorImg = "/accelerator-art.png";

// ART_GEN_MODE instructions:
// This is a temporary mode that allows for generating ASCII art from images with style similar to base images in public folder (e.g. cpu.png)
// Set this to true to generate ASCII art from an image. Set it back to false when done.
// After setting it to true, change the src, and paramters in the first AsciiArt component below (Box 1: DRAM)
// Run: npm run dev
// In the browser console run:
//
// const c = document.querySelector('canvas[aria-label="ASCII art rendering of image"]'); const a = document.createElement('a'); a.href = c.toDataURL('image/png'); a.download = 'art-ascii-img.png'; a.click();
//
// This will trigger a download of the generated ASCII art image.
// Download the image and place it in the public folder, then set ART_GEN_MODE back to false.
const ART_GEN_MODE = false;
---

<section
  class="w-full max-w-5xl mx-auto px-4 pt-12 flex flex-col gap-6 items-center"
>
  {/* Top Row: The 3-Column Array of ASCII Art */}
  <div class="w-full grid grid-cols-3 max-w-3xl mx-auto gap-3 md:gap-6">
    {/* Box 1: DRAM */}
    <div
      class="bg-slate-950/50 rounded-2xl border border-white/10 flex items-center justify-center overflow-hidden aspect-square p-6"
    >
      {
        ART_GEN_MODE ? (
          // Pick an image to be converted to ASCII art and change paramters below. Don't forget to turn ART_GEN_MODE to false when done
          <AsciiArt
            client:load
            src="/dram.png"
            resolution={362}
            charset="blocks"
            color="#60a5fa"
            animated={false}
            inverted={true}
            className="w-full h-full"
            objectFit="contain"
          />
        ) : (
          <img
            src={dramImg}
            alt="DRAM Ascii Art"
            class="w-full h-full object-contain"
          />
        )
      }
    </div>

    {/* Box 2: CPU */}
    <div
      class="bg-slate-950/50 rounded-2xl border border-white/10 flex items-center justify-center overflow-hidden aspect-square p-6"
    >
      <img
        src={cpuImg}
        alt="CPU Ascii Art"
        class="w-full h-full object-contain"
      />
    </div>

    {/* Box 3: Accelerator */}
    <div
      class="bg-slate-950/50 rounded-2xl border border-white/10 flex items-center justify-center overflow-hidden aspect-square p-6"
    >
      <img
        src={acceleratorImg}
        alt="Accelerator Ascii Art"
        class="w-full h-full object-contain"
      />
    </div>
  </div>
</section>
