---
interface Props {
  text: string;
  route: string;
}
const { text, route } = Astro.props;
---

<div class="w-full flex justify-center pt-2 pb-2">
  <a
    href={route}
    class="group relative inline-flex items-center gap-3 px-8 py-4 bg-slate-950 border border-emerald-900/50 rounded-xl overflow-hidden transition-all duration-300 hover:border-emerald-500 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)]"
  >
    {/* Matrix Grid Background (Fades in on hover) */}
    <div
      class="absolute inset-0 opacity-10 group-hover:opacity-40 transition-opacity duration-500 bg-[linear-gradient(rgba(16,185,129,0.4)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.4)_1px,transparent_1px)] bg-size-[6px_6px] mask-[radial-gradient(ellipse_80%_80%_at_50%_50%,#000_10%,transparent_100%)]"
    >
    </div>

    {/* Button Text */}
    <span
      class="relative z-10 font-mono text-slate-300 group-hover:text-emerald-400 font-bold tracking-widest uppercase transition-colors"
    >
      {text}
    </span>

    {/* Terminal Logo Emulated Using >_ */}
    <span
      class="relative z-10 font-mono text-emerald-500 font-bold text-lg group-hover:translate-x-1 transition-transform"
    >
      >_
    </span>
  </a>
</div>
