---
import { MainProjects } from "./MainProjects";
import PushButton from "./PushButton.astro";
---

<section
  class="w-full max-w-5xl mx-auto px-4 pt-12 flex flex-col gap-4 items-center"
>
  {/* Section Label */}
  <div class="w-full max-w-5xl flex items-center justify-center pt-4 pb-2">
    <div class="h-px bg-emerald-900/35 w-full"></div>
    <span
      class="px-4 font-mono font-bold text-base md:text-xl text-slate-500 uppercase tracking-[0.3em] whitespace-nowrap"
    >
      /* SELECT PROJECTS */
    </span>
    <div class="h-px bg-emerald-900/35 w-full"></div>
  </div>

  {/* Terminal Command and Project Cards */}
  <div
    class="w-full max-w-5xl space-y-6 text-base md:text-xl text-slate-400 leading-relaxed font-sans"
  >
    {/* Terminal Command */}
    <div class="font-mono text-emerald-400 font-bold mb-4">
      <span>[abdullah@abdullahs ~]$ ls projects/</span>
    </div>

    {/* Project Cards */}
    <MainProjects client:visible />

    {/* Full Projects Button */}
    <PushButton text="Full Projects" route="/projects" isDownload={false} />
  </div>
</section>
