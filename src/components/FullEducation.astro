---
import { EducationTimeline } from "../components/EducationTimeline";
---

<section class="w-full max-w-5xl mx-auto px-4 pt-12">
  <div class="w-full flex flex-col items-center justify-center mb-6 gap-3">
    <div class="w-full flex items-center justify-center">
      <div class="h-px bg-emerald-900/35 w-full"></div>
      <span
        class="px-4 font-mono font-bold text-lg md:text-2xl text-slate-500 uppercase tracking-[0.3em] whitespace-nowrap"
      >
        /* EDUCATION LOG */
      </span>
      <div class="h-px bg-emerald-900/35 w-full"></div>
    </div>

    <span class="font-mono text-xs md:text-lg text-slate-600">
      // I think I'm educated?
    </span>
  </div>

  <EducationTimeline client:load />
</section>
