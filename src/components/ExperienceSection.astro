---
import ExperienceEntry from "./ExperienceEntry.astro";
import PushButton from "./PushButton.astro";
---

<section
  class="w-full max-w-5xl mx-auto px-4 pt-12 flex flex-col gap-4 items-center"
>
  {/* Section Label */}
  <div class="w-full max-w-5xl flex items-center justify-center pt-4 pb-2">
    <div class="h-px bg-emerald-900/35 w-full"></div>
    <span
      class="px-4 font-mono font-bold text-base md:text-xl text-slate-500 uppercase tracking-[0.3em] whitespace-nowrap"
    >
      /* SELECT EXPERIENCES */
    </span>
    <div class="h-px bg-emerald-900/35 w-full"></div>
  </div>

  {/* The Stacked Experience Cards */}
  <div class="w-full max-w-5xl flex flex-col gap-6">
    {/* UMich M-bits Experience */}
    <ExperienceEntry
      company="University-of-Michigan"
      role="Research-Assistant"
      logo="/umich.png"
      duration="2026 - Now"
      description={`Under the guidance of Dr. Reetu Das, I work on developing a cycle-accurate hardware emulation of a <a href="https://dl.acm.org/doi/10.1145/3676641.3716267" target="_blank" class="text-emerald-400 underline hover:text-emerald-300">CENT</a> device leveraging CMU's Ramulator2 DRAM simulator. 
                    <br /> This work targets the Amazon F2 Cloud FPGA (XCVU47P HBM2) to validate the emulation across different GPT and LLaMA inference workloads.`}
    />

    {/* Keysight R&D Experience */}
    <ExperienceEntry
      company="Keysight-Technologies"
      role="R&D-Engineer"
      logo="/keysight.png"
      duration="2024 - 2025"
      description={`During my time there, I worked on diverse projects. In the beginning, I developed a P4-based packet capture module inside a programmable switch pipeline to enable low-level network traffic debugging. 
                    <br /> After that, I worked on modernizing test equipment synchronization infrastructure by implementing custom RTL logic on timing FPGAs and its supporting gRPC microservices to allow for nanosecond-level precision.
                    <br /> Later, I moved to AI/HPC infrastructure and worked on optimizing DMA-based data movement using PCIe Gen5 on Xilinx Versal SoC.`}
    />

    {/* Cirrus Logic Experience */}
    <ExperienceEntry
      company="Cirrus-Logic"
      role="Applications-Engineer-Intern"
      logo="/cirrus.png"
      duration="2023 - 2023"
      description={`At this internship, I mainly worked on developing a unified Python API wrapping drivers of silicon emulation platforms with multiple FPGAs for internal and external customer workflows.
                    <br /> This helped standarize and simplify verification workflows by abstracting away underlying hardware variations across different emulation platforms.`}
    />
  </div>

  {/* Full Experience Button */}
  <PushButton text="Full Experience" route="/about" isDownload={false} />
</section>
