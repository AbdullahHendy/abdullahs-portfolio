---

<section class="w-full max-w-5xl mx-auto px-4 py-12 flex flex-col gap-12">
  {/* Section Header */}
  <div class="w-full flex items-center justify-center mb-4">
    <div class="h-px bg-emerald-900/35 w-full"></div>
    <span
      class="px-4 font-mono font-bold text-lg md:text-xl text-slate-500 uppercase tracking-[0.3em] whitespace-nowrap"
    >
      /* PROJECTS */
    </span>
    <div class="h-px bg-emerald-900/35 w-full"></div>
  </div>

  {/* Vertical Project Stack */}
  <div class="flex flex-col gap-20 items-center">
    {
      projects.map((project) => (
        <div class="w-full max-w-4xl flex flex-col items-center group">
          {/* Top: Title & GitHub Link */}
          <div class="w-full flex items-center justify-center relative mb-6">
            <h3 class="text-lg md:text-2xl font-bold text-slate-200 group-hover:text-emerald-400 transition-colors text-center">
              {project.title}
            </h3>

            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute right-0 text-slate-500 hover:text-emerald-400 transition-colors"
                aria-label="View Source on GitHub"
              >
                <FiGithub className="w-6 h-6 md:w-8 md:h-8 transition-all aduration-300 hover:scale-115 animate-[bounce_0.5s_ease-in-out_infinite] hover:animate-none" />
              </a>
            )}
          </div>

          {/* Middle: Image */}
          {project.image && (
            <div class="w-full md:w-3/4 aspect-video rounded-xl overflow-hidden border border-white/10 bg-slate-950 relative mb-8">
              <a
                href={project.image}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full h-full p-2"
              >
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-contain cursor-pointer group-hover:scale-105 transition-transform duration-700"
                />
              </a>
            </div>
          )}

          {/* Bottom: Description */}
          <p class="font-mono font-bold text-slate-300 text-base md:text-xl leading-relaxed mb-8 text-center px-4 md:px-12">
            {project.description}
          </p>

          {/* Footer: Tech Stack */}
          <div class="flex flex-wrap justify-center gap-3">
            {project.stack.map((tech) => (
              <span class="px-3 py-1.5 bg-slate-900/50 border border-white/5 text-emerald-500 font-mono text-sm md:text-base rounded-md">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
